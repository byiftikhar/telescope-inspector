{
    "name": "byiftikhar/telescope-inspector",
    "description": "Fast, searchable viewer for Laravel Telescope, the Laravel debug assistant: search and filter requests, jobs, queries, logs and exceptions by route, user, status and duration, with dark mode and date-range pruning.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Iftikhar",
            "homepage": "https://github.com/byiftikhar",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/byiftikhar/telescope-inspector/issues",
        "source": "https://github.com/byiftikhar/telescope-inspector"
    },
    "keywords": [
        "laravel",
        "telescope",
        "laravel-telescope",
        "debugging",
        "monitoring",
        "debug",
        "debugbar",
        "profiler",
        "developer-tools",
        "laravel-package",
        "telescope-viewer",
        "search",
        "filter",
        "requests",
        "queries",
        "jobs",
        "exceptions",
        "logs",
        "performance",
        "prune",
        "dark-mode"
    ],
    "homepage": "https://github.com/byiftikhar/telescope-inspector",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/telescope": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ByIftikhar\\TelescopeInspector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ByIftikhar\\TelescopeInspector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ByIftikhar\\TelescopeInspector\\TelescopeInspectorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
